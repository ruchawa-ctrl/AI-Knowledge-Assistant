# --- LLM / Embedding provider ---
# Works with OpenAI, or any OpenAI-compatible endpoint (e.g. Ollama, LM Studio, Together).
# For OpenAI: leave OPENAI_BASE_URL empty and set OPENAI_API_KEY.
# For Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1  and OPENAI_API_KEY=ollama
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=

# Models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Storage ---
# Where the SQLite metadata DB and Chroma vector store live
DATA_DIR=./data

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# --- Server ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
